# Copie para .env.vps na VPS e nunca envie esse arquivo ao repositorio.
BACKEND_HOST_PORT=18000
FRONTEND_HOST_PORT=18080
VITE_API_URL=https://recruta-api.vps6912.panel.icontainer.net

# Use o usuario/banco exclusivos criados no painel Integrator.
# Codifique caracteres especiais da senha para URL (%40 para @, %23 para # etc.).
DATABASE_URL=postgresql+asyncpg://USUARIO:SENHA_URL_ENCODED@host.docker.internal:5432/BANCO
REDIS_URL=redis://hospedagem-redis:6379/1

FRONTEND_URL=https://recruta.sienixsistemas.com.br
CORS_ORIGINS=["https://recruta.sienixsistemas.com.br"]

JWT_SECRET_KEY=CONFIGURE_NO_AMBIENTE
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30
MAX_ACTIVE_JOBS_PER_COMPANY=10
CNPJ_LOOKUP_URL=https://brasilapi.com.br/api/cnpj/v1
CNPJ_LOOKUP_TIMEOUT_SECONDS=8
SMTP_ENABLED=true
SMTP_HOST=email-ssl.com.br
SMTP_PORT=465
SMTP_USERNAME=nao-responda@lokeihoteis.com.br
SMTP_PASSWORD=troque-pela-senha-real-da-caixa
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=15
EMAIL_FROM=nao-responda@lokeihoteis.com.br
EMAIL_FROM_NAME=Recruta IA
EMAIL_REPLY_TO=nao-responda@lokeihoteis.com.br
INTERNAL_SERVICE_TOKEN=CONFIGURE_NO_AMBIENTE

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# true durante a homologacao; altere para false junto com as credenciais de producao.
MERCADOPAGO_SANDBOX=true
# Opcional no Checkout Pro; mantido somente para compatibilidade com o fluxo PIX legado.
MERCADOPAGO_PAYER_EMAIL=
PAYMENT_SETTINGS_ENCRYPTION_KEY=troque-por-uma-chave-longa-e-aleatoria-de-no-minimo-32-caracteres

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://recruta-api.vps6912.panel.icontainer.net/v1/auth/oauth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://recruta-api.vps6912.panel.icontainer.net/v1/auth/oauth/linkedin/callback
