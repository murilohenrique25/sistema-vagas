# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.0

# Service Configuration
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
SERVICE_NAME=ai-recruitment-service
SERVICE_VERSION=0.1.0

# Backend Communication
BACKEND_BASE_URL=http://localhost:8000
BACKEND_API_PREFIX=/v1
BACKEND_TIMEOUT=30
BACKEND_RETRY_ATTEMPTS=3
BACKEND_RETRY_DELAY=1.0

# Internal Service Authentication
INTERNAL_SERVICE_TOKEN=your-internal-service-token-here

# Timeouts (seconds)
PDF_EXTRACTION_TIMEOUT=60
CANDIDATE_ANALYSIS_TIMEOUT=60
JOB_MATCHING_TIMEOUT=30
