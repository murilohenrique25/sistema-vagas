# Application
APP_NAME="Sistema Vagas API"
APP_VERSION="0.1.0"
DEBUG=true
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sistema_vagas

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_CACHE_TTL=300
REDIS_SESSION_TTL=86400

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30
SMTP_ENABLED=false
SMTP_HOST=email-ssl.com.br
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=15
EMAIL_FROM=
EMAIL_FROM_NAME=Recruta IA
EMAIL_REPLY_TO=
MAX_ACTIVE_JOBS_PER_COMPANY=10

# OAuth2 - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/oauth/google/callback

# OAuth2 - LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/v1/auth/oauth/linkedin/callback

# AI Service
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=120
INTERNAL_SERVICE_TOKEN=replace-with-a-random-32-character-secret

# Payments
PAYMENT_GATEWAY=sandbox
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_PAYER_EMAIL=

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# OpenAPI
OPENAPI_URL=/openapi.json
DOCS_URL=/docs
REDOC_URL=/redoc
